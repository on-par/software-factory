# Runtime state (per-repo, created by the factory)
.factory/

# Scratch worktrees/clones for manual conflict resolution etc. — never
# belongs inside the repo tree (2026-08-16: an abandoned .tmp/wt-711
# worktree sat here untracked and got picked up by `prettier --check .`,
# breaking format:check for every unrelated verify.sh run until removed).
.tmp/

# OS files
.DS_Store

# Editor
.vscode/
.idea/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Stryker mutation-testing HTML/JSON output (#884). Anchored to repo root —
# unanchored `reports/` would also shadow the tracked packages/core/src/reports/.
/reports/

# Raw SCBench run outputs (scbench.run.yaml's save_dir, repo-root relative).
# Multi-gigabyte and never baseline evidence — collect-trial copies the
# retained files into evals/scbench-baseline/runs/ instead (#1165).
/outputs/

# Python
__pycache__/
*.pyc

# Logs
*.log

# Python
__pycache__/
*.pyc
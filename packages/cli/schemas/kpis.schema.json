{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kpis": {
      "type": "object",
      "properties": {},
      "additionalProperties": {}
    },
    "openFactoryDrafts": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "number"
            },
            "oldestHours": {
              "type": ["number", "null"]
            }
          },
          "required": ["count", "oldestHours"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["schemaVersion", "kpis", "openFactoryDrafts"],
  "additionalProperties": false
}

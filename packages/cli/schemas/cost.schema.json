{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "inputTokens": {
            "type": "number"
          },
          "outputTokens": {
            "type": "number"
          },
          "rawInputTokens": {
            "type": ["number", "null"]
          },
          "cacheReadTokens": {
            "type": ["number", "null"]
          },
          "cacheCreationTokens": {
            "type": ["number", "null"]
          },
          "cost": {
            "type": ["number", "null"]
          }
        },
        "required": [
          "ts",
          "issue",
          "task",
          "model",
          "inputTokens",
          "outputTokens",
          "rawInputTokens",
          "cacheReadTokens",
          "cacheCreationTokens",
          "cost"
        ],
        "additionalProperties": false
      }
    },
    "perModel": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "tasks": {
            "type": "number"
          },
          "inputTokens": {
            "type": "number"
          },
          "outputTokens": {
            "type": "number"
          },
          "rawInputTokens": {
            "type": "number"
          },
          "cacheReadTokens": {
            "type": "number"
          },
          "cacheCreationTokens": {
            "type": "number"
          },
          "cost": {
            "type": ["number", "null"]
          },
          "unpricedCount": {
            "type": "number"
          },
          "cachedRateMissingCount": {
            "type": "number"
          }
        },
        "required": [
          "model",
          "tasks",
          "inputTokens",
          "outputTokens",
          "rawInputTokens",
          "cacheReadTokens",
          "cacheCreationTokens",
          "cost",
          "unpricedCount",
          "cachedRateMissingCount"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "object",
      "properties": {
        "cost": {
          "type": ["number", "null"]
        },
        "unpricedCount": {
          "type": "number"
        },
        "cachedRateMissingCount": {
          "type": "number"
        },
        "tokens": {
          "type": "object",
          "properties": {
            "input": {
              "type": "number"
            },
            "output": {
              "type": "number"
            },
            "rawInput": {
              "type": "number"
            },
            "cacheRead": {
              "type": "number"
            },
            "cacheCreation": {
              "type": "number"
            }
          },
          "required": ["input", "output", "rawInput", "cacheRead", "cacheCreation"],
          "additionalProperties": false
        }
      },
      "required": ["cost", "unpricedCount", "cachedRateMissingCount", "tokens"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "rows", "perModel", "total"],
  "additionalProperties": false
}

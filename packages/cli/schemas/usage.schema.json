{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "enum": ["subscription", "heuristic", "unavailable"]
    },
    "utilizationPct": {
      "type": ["number", "null"]
    },
    "resetsAt": {
      "type": ["string", "null"]
    },
    "windowHours": {
      "type": "number"
    },
    "estimateUsd": {
      "type": ["number", "null"]
    },
    "plan": {
      "type": "string",
      "enum": ["subscription", "api", "unknown"],
      "description": "Detected from this machine profile's Claude Code auth (API key over login); a hint the client may override."
    }
  },
  "required": ["schemaVersion", "source", "utilizationPct", "resetsAt", "windowHours", "estimateUsd", "plan"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "enum": ["subscription", "heuristic", "unavailable"]
    },
    "utilizationPct": {
      "type": ["number", "null"]
    },
    "resetsAt": {
      "type": ["string", "null"]
    },
    "windowHours": {
      "type": "number"
    },
    "estimateUsd": {
      "type": ["number", "null"]
    },
    "plan": {
      "type": "string",
      "enum": ["subscription", "api", "unknown"],
      "description": "How this machine profile's Claude Code is signed in: 'api' when ANTHROPIC_API_KEY is set (API key over login), 'subscription' for a stored Claude login, else 'unknown'. Detected from auth without reading a secret; a hint the client may override (#3214)."
    }
  },
  "required": ["schemaVersion", "source", "utilizationPct", "resetsAt", "windowHours", "estimateUsd", "plan"],
  "additionalProperties": false
}

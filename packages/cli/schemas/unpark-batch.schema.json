{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "action": {
      "type": "string",
      "const": "unpark-batch"
    },
    "results": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "ok": {
                "type": "boolean",
                "const": true
              },
              "action": {
                "type": "string",
                "const": "unpark"
              },
              "issue": {
                "type": "number"
              },
              "lane": {
                "type": "string"
              },
              "order": {
                "type": "number"
              },
              "collision": {
                "type": "object",
                "properties": {
                  "order": {
                    "type": "number"
                  },
                  "heldBy": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": ["order", "heldBy"],
                "additionalProperties": false
              },
              "labelsBefore": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labelsAfter": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["schemaVersion", "ok", "action", "issue", "lane", "order", "labelsBefore", "labelsAfter"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "ok": {
                "type": "boolean",
                "const": false
              },
              "action": {
                "type": "string",
                "const": "unpark"
              },
              "issue": {
                "type": "number"
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": ["not-parked", "lane-required", "unpark-failed"]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": ["code", "message"],
                "additionalProperties": false
              }
            },
            "required": ["schemaVersion", "ok", "action", "issue", "error"],
            "additionalProperties": false
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "number"
        },
        "failed": {
          "type": "number"
        }
      },
      "required": ["ok", "failed"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "action", "results", "summary"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 4
    },
    "issue": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "repo": {
      "type": ["string", "null"]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "merged",
        "pr-open",
        "held",
        "ci-failed",
        "parked",
        "failed",
        "land-deferred",
        "closed",
        "awaiting-review",
        "budget_exhausted"
      ]
    },
    "exitReason": {
      "type": "string",
      "minLength": 1
    },
    "pr": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "url": {
              "type": ["string", "null"]
            },
            "state": {
              "type": "string",
              "enum": ["open", "draft", "merged", "closed"]
            }
          },
          "required": ["number", "url", "state"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "type": ["string", "null"]
    },
    "baseSha": {
      "type": ["string", "null"]
    },
    "headSha": {
      "type": ["string", "null"]
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "startedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": ["string", "null"]
          },
          "model": {
            "type": ["string", "null"]
          },
          "attempts": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": ["name", "startedAt", "finishedAt", "model", "attempts"],
        "additionalProperties": false
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "usd": {
          "type": "number"
        },
        "byModel": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": ["usd", "byModel"],
      "additionalProperties": false
    },
    "reworkRounds": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "landDeferrals": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "handoff": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "stopReason": {
          "type": "string",
          "enum": ["deadline", "sigterm"]
        },
        "phase": {
          "type": "string",
          "enum": ["plan", "build", "check", "ship"]
        },
        "baseSha": {
          "type": ["string", "null"]
        },
        "wipBranch": {
          "type": ["string", "null"]
        },
        "headSha": {
          "type": ["string", "null"]
        },
        "specPath": {
          "type": ["string", "null"]
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["done", "failing", "not_started"]
              },
              "proof": {
                "type": ["string", "null"]
              }
            },
            "required": ["criterion", "status", "proof"],
            "additionalProperties": false
          }
        },
        "lastFailure": {
          "type": ["string", "null"]
        },
        "nextStep": {
          "type": "string"
        },
        "fitsOneRun": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "stopReason",
        "phase",
        "baseSha",
        "wipBranch",
        "headSha",
        "specPath",
        "criteria",
        "lastFailure",
        "nextStep",
        "fitsOneRun"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "issue",
    "repo",
    "outcome",
    "exitReason",
    "pr",
    "branch",
    "baseSha",
    "headSha",
    "startedAt",
    "finishedAt",
    "phases",
    "cost",
    "reworkRounds",
    "prerequisites"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "exit": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string"
    },
    "cost": {
      "type": ["number", "null"]
    }
  },
  "required": ["schemaVersion", "title", "body", "score", "exit", "reasons", "model", "cost"],
  "additionalProperties": false
}

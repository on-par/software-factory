{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "repo": {
      "type": "string"
    },
    "stopFlag": {
      "type": "object",
      "properties": {
        "before": {
          "type": "boolean"
        },
        "after": {
          "type": "boolean"
        }
      },
      "required": ["before", "after"],
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "const": "resume"
    }
  },
  "required": ["schemaVersion", "ok", "repo", "stopFlag", "action"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "running": {
      "type": "boolean"
    },
    "pid": {
      "type": ["number", "null"]
    },
    "uptimeSec": {
      "type": ["number", "null"]
    },
    "plistInstalled": {
      "type": "boolean"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "checkoutPath": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["active", "paused", "draining", "detached"]
          }
        },
        "required": ["slug", "checkoutPath", "state"],
        "additionalProperties": false
      }
    },
    "load": {
      "type": "object",
      "properties": {
        "activeRuns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "maxSlots": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "queueDepth": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["activeRuns", "maxSlots", "queueDepth"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "running", "pid", "uptimeSec", "plistInstalled", "repos", "load"],
  "additionalProperties": false
}

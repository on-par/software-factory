{
  "name": "@on-par/factory-cli",
  "version": "0.9.2",
  "description": "On PAR Dev's Software Factory CLI: takes a GitHub issue through plan, build and check with AI agents, then opens a ready-for-review PR.",
  "keywords": [
    "ai-agents",
    "github",
    "cli",
    "claude-code",
    "pull-requests",
    "automation"
  ],
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "factory": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/on-par/software-factory.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/on-par/software-factory#readme",
  "bugs": {
    "url": "https://github.com/on-par/software-factory/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../scripts/pack-hygiene-cli.ts prepack"
  },
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.0",
    "@on-par/factory-core": "^0.9.2",
    "@on-par/factory-tui": "^0.9.2",
    "commander": "^15.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}

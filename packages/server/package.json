{
  "name": "@on-par/factory-server",
  "private": true,
  "version": "2.0.0",
  "description": "Local HTTP server for the factory — exposes the lane lifecycle bus as an SSE stream on GET /events. Private, never published.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/dev-server.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@on-par/contracts": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}

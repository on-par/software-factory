{
  "name": "@on-par/factory-server",
  "private": true,
  "version": "0.9.24",
  "description": "Local HTTP server for the factory \u2014 exposes the lane lifecycle bus as an SSE stream on GET /events. Private, never published.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@on-par/contracts": "^0.9.24"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}

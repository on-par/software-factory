{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exports referenced within their own module are internal helpers, not
  // dead code — don't force export-keyword churn on them (#143).
  "ignoreExportsUsedInFile": true,
  // The anti-slop plugin is vendored, not authored here (#795): its files are loaded by
  // oxlint through a config specifier string, which knip cannot follow.
  // scripts/verify-env-probe.mjs is run by scripts/verify.sh through node, which knip does not follow (#3332).
  "ignore": ["tools/oxlint/anti-slop/**", "scripts/verify-env-probe.mjs"],
  "workspaces": {
    "packages/cli": {
      // `ollama` is an external runtime binary the CLI shells out to;
      // it is never an npm dependency.
      "ignoreBinaries": ["ollama"],
    },
  },
}
